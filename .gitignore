# SpotBro .gitignore

# ==========================================
# Python
# ==========================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
ENV/
.venv/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Python distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyCharm
.idea/
*.iml

# VS Code
.vscode/
*.code-workspace

# ==========================================
# Machine Learning
# ==========================================
# Large model files (use Git LFS if needed)
*.pkl
*.h5
*.pb
*.ckpt
*.pth

# Training data (don't commit raw videos/images)
ml/data/raw_videos/*.mp4
ml/data/raw_videos/*.avi
ml/data/raw_videos/*.mov
ml/data/images/*.jpg
ml/data/images/*.png

# Keep processed CSVs but not raw
ml/data/raw/

# Tensorboard logs
logs/
runs/

# ==========================================
# PHP / Backend
# ==========================================
# XAMPP logs
/xampp/logs/

# PHP session files
/tmp/

# Composer dependencies
vendor/
composer.lock

# ==========================================
# Database
# ==========================================
# Database dumps (include template but not real data)
*.sql
!schema.sql
!seeds.sql

# Database config (if it contains passwords)
# Uncomment if you want to exclude:
# backend/config/database.php

# ==========================================
# Frontend
# ==========================================
# Node modules (if you add npm later)
node_modules/
package-lock.json

# Build files
dist/
build/

# ==========================================
# IDE & Editors
# ==========================================
# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# Sublime Text
*.sublime-project
*.sublime-workspace

# ==========================================
# OS Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ==========================================
# Environment & Secrets
# ==========================================
.env
.env.local
.env.*.local
*.key
*.pem
secrets/

# ==========================================
# Logs
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Testing
# ==========================================
coverage/
.coverage
htmlcov/
.pytest_cache/
.tox/

# ==========================================
# Documentation (optional)
# ==========================================
# Uncomment if you want to exclude auto-generated docs
# docs/_build/
# site/

# ==========================================
# Temporary Files
# ==========================================
tmp/
temp/
*.tmp
*.bak
*.backup

# ==========================================
# Project Specific
# ==========================================
# Uploaded user videos/images (if you add this feature)
frontend/uploads/

# Session recordings
recordings/

# User data exports
exports/

# ==========================================
# KEEP THESE (examples)
# ==========================================
# Keep empty directories with .gitkeep
!.gitkeep

# Keep template/example files
!example.env
!config.example.php